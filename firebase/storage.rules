rules_version = '2';

// Only used for optional menu item photos uploaded from the admin
// dashboard. Payment verification no longer needs Storage at all — manual
// bank transfers are confirmed by sender name + a matching bank alert, no
// receipt upload required.
service firebase.storage {
  match /b/{bucket}/o {
    match /menu/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
