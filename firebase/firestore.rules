rules_version = '2';

// Corpers Kitchen: guest checkout remains supported. Staff permissions require
// an explicit admins/{uid} record; authentication alone never grants admin access.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    function isValidReview(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() < 60
        && d.rating is number && d.rating >= 1 && d.rating <= 5
        && d.comment is string && d.comment.size() > 0 && d.comment.size() < 1000
        && d.createdAt is number;
    }

    function chatIsOpen() {
      return get(/databases/$(database)/documents/settings/chat).data.enabled == true;
    }

    function validCustomerChat(d) {
      return d.keys().hasOnly(['orderId', 'orderNumber', 'name', 'text', 'createdAt', 'isStaff'])
        && d.orderId is string
        && d.orderNumber is string
        && d.name is string && d.name.size() > 0 && d.name.size() <= 30
        && d.text is string && d.text.size() > 0 && d.text.size() <= 200
        && d.createdAt is number
        && d.isStaff == false
        && exists(/databases/$(database)/documents/orders/$(d.orderId))
        && get(/databases/$(database)/documents/orders/$(d.orderId)).data.orderNumber == d.orderNumber
        && get(/databases/$(database)/documents/orders/$(d.orderId)).data.status != 'cancelled'
        && !exists(/databases/$(database)/documents/chatMutes/$(d.orderNumber));
    }

    function validStaffChat(d) {
      return isAdmin()
        && d.text is string && d.text.size() > 0 && d.text.size() <= 200
        && d.name is string && d.createdAt is number && d.isStaff == true;
    }

    // Staff identities are provisioned out-of-band in Firebase Console/Admin SDK.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Existing food ordering system.
    match /menuItems/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if true;
      // Orders and private phone details are created by the trusted createOrder callable.
      allow create: if false;
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'updatedAt', 'deliveredAt', 'paymentStatus', 'actualReadyAt', 'confirmedAt'
          ]))
        || (resource.data.paymentMethod == 'manual_transfer'
          && resource.data.paymentStatus in ['pending', 'rejected']
          && request.resource.data.paymentStatus == 'submitted'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'paymentStatus', 'paymentReference', 'updatedAt'
          ]));
      allow delete: if false;

      match /private/{docId} {
        allow read: if isAdmin();
        allow create, update, delete: if false;
      }
    }

    match /paymentSubmissions/{id} {
      allow read: if isAdmin();
      allow create: if request.resource.data.orderId is string
        && exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId))
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.orderNumber == request.resource.data.orderNumber
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.total == request.resource.data.total
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.paymentMethod == 'manual_transfer'
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.paymentStatus in ['pending', 'rejected']
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() > 0 && request.resource.data.senderName.size() <= 80
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['orderId', 'orderNumber', 'customerName', 'total', 'items', 'senderName', 'notes', 'status', 'createdAt']);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt']);
      allow delete: if false;
    }

    match /reviews/{id} {
      allow read: if true;
      allow create: if isValidReview(request.resource.data);
      allow update, delete: if false;
    }

    match /chatMessages/{id} {
      allow read: if true;
      allow create: if validStaffChat(request.resource.data)
        || (chatIsOpen() && validCustomerChat(request.resource.data));
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /chatMutes/{orderNumber} {
      allow read, write: if isAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // These collections are controlled by trusted server functions only.
    match /counters/{id} { allow read, write: if false; }
    match /idempotency/{id} { allow read, write: if false; }
    match /paystackReferences/{id} { allow read, write: if false; }
    match /confessionMeta/{id} { allow read: if isAdmin(); allow write: if false; }
    match /confessionRateLimits/{id} { allow read, write: if false; }
    match /quizChallenges/{id} { allow read, write: if false; }
    match /gameAttempts/{id} { allow read, write: if false; }
    match /quizStarts/{id} { allow read, write: if false; }
    match /xpEvents/{id} { allow read, write: if false; }
    match /commentCountEvents/{id} { allow read, write: if false; }
    match /giftRequests/{id} { allow read, write: if false; }
    match /roomChatRateLimits/{id} { allow read, write: if false; }
    match /directMessageRateLimits/{id} { allow read, write: if false; }
    match /postRateLimits/{id} { allow read, write: if false; }
    match /commentRateLimits/{id} { allow read, write: if false; }
    match /gameScores/{id} { allow read, write: if false; }

    // Member profiles. Owners can edit presentation fields, never XP or badges.
    match /profiles/{uid} {
      allow read: if signedIn()
        && (resource.data.isPrivate != true || request.auth.uid == uid || isAdmin() || exists(/databases/$(database)/documents/friendships/$(request.auth.uid + '_' + uid)));
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.xp == 0
        && request.resource.data.level == 1
        && request.resource.data.badges == []
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 40
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 160
        && request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2048
        && request.resource.data.isPrivate is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'username', 'bio', 'photoURL', 'createdAt', 'xp', 'level', 'badges', 'isPrivate'
        ])
        && existsAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username))
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'bio', 'photoURL', 'isPrivate', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 160
        && request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2048
        && request.resource.data.isPrivate is bool
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;

      match /notifications/{notificationId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read == true;
        allow create, delete: if false;
      }
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update, delete: if false;
    }

    match /posts/{postId} {
      allow read: if signedIn() && resource.data.status == 'published';
      allow create: if false; // Posts are rate-limited and written by a callable function.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && request.resource.data.likes is list
        && request.resource.data.likes.size() <= 5000
        && request.resource.data.likes.toSet().size() == request.resource.data.likes.size()
        && ((request.auth.uid in request.resource.data.likes && !(request.auth.uid in resource.data.likes)
            && request.resource.data.likes.size() == resource.data.likes.size() + 1
            && request.resource.data.likes.hasAll(resource.data.likes))
          || (!(request.auth.uid in request.resource.data.likes) && request.auth.uid in resource.data.likes
            && resource.data.likes.size() == request.resource.data.likes.size() + 1
            && resource.data.likes.hasAll(request.resource.data.likes)));
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);

      match /comments/{commentId} {
        allow read: if signedIn() && exists(/databases/$(database)/documents/posts/$(postId)) && get(/databases/$(database)/documents/posts/$(postId)).data.status == 'published';
        allow create: if false; // Comments are rate-limited and written by a callable function.
        allow update: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text']) && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500);
        allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      }
    }

    // The public confession document contains no author UID or profile reference.
    match /confessions/{id} {
      allow read: if signedIn() && resource.data.status == 'published';
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    match /friendRequests/{id} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.to))
        && get(/databases/$(database)/documents/profiles/$(request.resource.data.to)).data.isPrivate != true
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly(['from', 'to', 'status', 'createdAt']);
      allow update: if signedIn()
        && resource.data.to == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
        && request.resource.data.status in ['accepted', 'declined']
        && request.resource.data.respondedAt is timestamp
        && (request.resource.data.status == 'declined'
          || (existsAfter(/databases/$(database)/documents/friendships/$(resource.data.from + '_' + resource.data.to))
            && existsAfter(/databases/$(database)/documents/friendships/$(resource.data.to + '_' + resource.data.from))));
      allow delete: if false;
    }

    match /friendships/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.users
        && request.resource.data.users.size() == 2
        && request.resource.data.users[0] != request.resource.data.users[1]
        && id == request.resource.data.users[0] + '_' + request.resource.data.users[1]
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly(['users', 'createdAt'])
        && ((existsAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.users[0] + '_' + request.resource.data.users[1]))
            && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.users[0] + '_' + request.resource.data.users[1])).data.status == 'accepted')
          || (existsAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.users[1] + '_' + request.resource.data.users[0]))
            && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.users[1] + '_' + request.resource.data.users[0])).data.status == 'accepted'));
      allow update, delete: if false;
    }

    match /conversations/{threadId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create, update: if false; // Private conversations are created and updated by a callable function.
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(threadId)).data.members;
        allow create: if false; // Messages are rate-limited and written by a callable function.
        allow update: if signedIn()
          && request.auth.uid == resource.data.to
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read == true;
        allow delete: if false;
      }
    }


    match /communityRoomMessages/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.roomId in ['lounge', 'food', 'tech']);
      allow create: if false; // Messages are rate-limited and written by a callable function.
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /giftLedger/{id} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow write: if false;
    }

    match /reports/{id} {
      allow create: if signedIn()
        && request.resource.data.reporter == request.auth.uid
        && request.resource.data.itemType in ['post', 'confession']
        && request.resource.data.itemId is string
        && request.resource.data.reason is string && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 200
        && request.resource.data.itemId.size() <= 150
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly(['reporter', 'itemType', 'itemId', 'reason', 'status', 'createdAt']);
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt']);
      allow delete: if isAdmin();
    }
  }
}
