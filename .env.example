# Firebase Console → Project Settings → General → Your apps → SDK setup and config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Paystack Dashboard → Settings → API Keys. PUBLIC key only (pk_test_… / pk_live_…) — never the secret key.
# Customers only see Paystack if you also switch it on in Admin → Overview.
VITE_PAYSTACK_PUBLIC_KEY=

# Set true only for local development with Firebase Emulator Suite
VITE_USE_FIREBASE_EMULATORS=false
