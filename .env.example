# Firebase Web SDK config — get these from:
# Firebase Console → Project Settings → General → Your apps → SDK setup and config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Paystack — get this from Paystack Dashboard → Settings → API Keys & Webhooks
# Use your TEST public key (starts with pk_test_) while developing, and
# switch to your LIVE public key (starts with pk_live_) only once you're
# ready to accept real payments. Customers can still choose Bank Transfer
# instead of Paystack even if this isn't set.
VITE_PAYSTACK_PUBLIC_KEY=
